// Cloudflare Workers Builds runs `npm run build`, then `npx wrangler deploy`. This file
// makes that deploy upload dist/ as static assets, with no Worker script. Without it,
// Wrangler's automatic setup runs `astro add cloudflare`, turns the site into a server
// app, and fails the build. The site must stay static (README, "Deploy").
{
  "name": "temperanda-website",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // /checkpoint/ serves checkpoint/index.html, and /checkpoint redirects to it.
    "html_handling": "auto-trailing-slash",
    // An unknown path gets dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
