---
/** Renders an entry from the `pages` collection (src/content/pages/*.md). */
import { getEntry, render } from 'astro:content';
import Base from './Base.astro';
import Section from '../components/Section.astro';
import Glow from '../components/Glow.astro';
import Prose from '../components/Prose.astro';

interface Props {
  id: string;
  eyebrow?: string;
}

const { id, eyebrow } = Astro.props;
const entry = await getEntry('pages', id);
if (!entry) {
  throw new Error(`No entry "${id}" in src/content/pages`);
}
const { Content } = await render(entry);
const { title, description, updated } = entry.data;
// Dates in frontmatter parse as UTC midnight; format in UTC so the day never shifts.
const updatedLabel = updated?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={title} description={description}>
  <div class="relative overflow-hidden">
    <Glow x="15%" y="0%" width="60%" height="35%" opacity={0.2} />
    <Section as="h1" align="left" eyebrow={eyebrow ?? title} heading={title} intro={description}>
      <div class="max-w-[680px]">
        {
          updated && (
            <p class="eyebrow mb-8">
              Last updated <time datetime={updated.toISOString().slice(0, 10)}>{updatedLabel}</time>
            </p>
          )
        }
        <Prose>
          <Content />
        </Prose>
      </div>
    </Section>
  </div>
</Base>
