---
import { site } from '../data/site';
import Glow from './Glow.astro';

const year = new Date().getFullYear();
const socials = site.socials.filter((s) => s.url);
const siteLinks = [...site.nav, { href: '/privacy/', label: 'Privacy' }];
const linkClass = 'font-mono text-sm text-ink-2 transition-colors duration-200 hover:text-link';
---

<footer class="relative overflow-hidden shadow-[inset_0_1px_0_var(--color-line)]">
  <Glow x="78%" y="100%" width="55%" height="90%" opacity={0.16} />
  <div
    class="site-wrap-wide relative z-[1] flex flex-col justify-between gap-10 pb-10 pt-12 md:flex-row md:gap-16 md:pb-14 md:pt-16"
  >
    <div class="max-w-[440px]">
      <a href="/" class="rounded-btn-sm text-2xl font-medium tracking-tighter">{site.name}</a>
      <p class="mt-3 text-sm text-ink-2">{site.description}</p>
    </div>

    <div class="flex flex-wrap gap-x-12 gap-y-8">
      <div>
        <p class="eyebrow">Site</p>
        <ul class="mt-4 space-y-2.5">
          {siteLinks.map((item) => (
            <li><a href={item.href} class={linkClass}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      {
        socials.length > 0 && (
          <div>
            <p class="eyebrow">Elsewhere</p>
            <ul class="mt-4 space-y-2.5">
              {socials.map((s) => (
                <li>
                  <a href={s.url} rel="me noopener" class={linkClass}>
                    {s.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div>
        <p class="eyebrow">Contact</p>
        <ul class="mt-4 space-y-2.5">
          <li><a href={`mailto:${site.email}`} class={linkClass}>{site.email}</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="relative z-[1] shadow-[inset_0_1px_0_var(--color-line)]">
    <div class="site-wrap-wide flex flex-col gap-1 py-[18px] text-center md:flex-row md:justify-between md:text-left">
      <p class="eyebrow">© {year} {site.name}</p>
      <p class="eyebrow">iPhone apps · Max for Live · Audio plugins</p>
    </div>
  </div>
</footer>
