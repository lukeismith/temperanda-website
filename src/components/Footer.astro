---
import { site } from '../data/site';

const year = new Date().getFullYear();
const socials = site.socials.filter((s) => s.url);
const siteLinks = [...site.nav, { href: '/privacy/', label: 'Privacy' }];
const linkClass = 'font-mono text-sm text-muted transition-colors hover:text-ink';
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-site px-6 py-16">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div>
        <p class="text-4xl font-medium tracking-tighter">{site.name}</p>
        <p class="mt-4 max-w-[34ch] text-sm text-muted">{site.description}</p>
      </div>

      <div>
        <p class="eyebrow">Site</p>
        <ul class="mt-4 space-y-2">
          {siteLinks.map((item) => (
            <li><a href={item.href} class={linkClass}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      {
        socials.length > 0 && (
          <div>
            <p class="eyebrow">Elsewhere</p>
            <ul class="mt-4 space-y-2">
              {socials.map((s) => (
                <li>
                  <a href={s.url} rel="me noopener" class={linkClass}>
                    {s.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div>
        <p class="eyebrow">Contact</p>
        <ul class="mt-4 space-y-2">
          <li><a href={`mailto:${site.email}`} class={linkClass}>{site.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
      <p class="eyebrow">© {year} {site.name}</p>
      <p class="eyebrow">iPhone apps · Max for Live · Audio plugins</p>
    </div>
  </div>
</footer>
