---
/**
 * Product entry.
 * `default`: a glass card for the product grids, with the screenshot peeking up
 * from the bottom of the art (or placeholder art), and the whole card as the link.
 * `wide`: the full-width home-page block with the app icon and a rounded screenshot.
 * It takes the product's own theme, so each app shows in its colours.
 * Stubs render as an unlinked "Unannounced" card in both variants.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { categoryLabel, getPrimaryCta } from '../data/product-meta';
import StatusBadge from './StatusBadge.astro';
import PlaceholderArt from './PlaceholderArt.astro';
import ProductCta from './ProductCta.astro';
import Glow from './Glow.astro';

interface Props {
  product: CollectionEntry<'products'>;
  variant?: 'default' | 'wide';
}

const { product, variant = 'default' } = Astro.props;
const { name, tagline, description, category, platforms, status, stub, featured, heroImage, heroImageAlt, icon, theme } =
  product.data;
const href = `/products/${product.id}/`;
const meta = [categoryLabel[category], ...platforms].join(' · ');
const cta = getPrimaryCta(product);
---

{
  variant === 'wide' ? (
    <article
      data-theme={theme === 'studio' ? undefined : theme}
      class="glass-card overflow-hidden"
      aria-labelledby={`product-${product.id}`}
    >
      <Glow x="80%" y="70%" width="60%" height="80%" opacity={0.22} />
      <div class="relative z-[1] grid items-center gap-10 p-6 sm:p-10 md:grid-cols-[minmax(0,1fr)_auto] md:gap-12 lg:p-14">
        <div data-reveal>
          <div class="flex items-center gap-4">
            {icon && (
              <Image
                src={icon}
                alt=""
                widths={[64, 128, 192]}
                sizes="64px"
                class="size-16 rounded-[22.5%] ring ring-line"
              />
            )}
            <p class="eyebrow">{featured ? `Featured · ${meta}` : meta}</p>
          </div>
          <h3
            id={`product-${product.id}`}
            class:list={['mt-6 text-4xl font-medium tracking-tighter', stub && 'text-ink-2']}
          >
            {name}
          </h3>
          <p class="mt-4 max-w-[30ch] text-xl">{tagline}</p>
          {description && <p class="mt-4 max-w-[46ch] text-ink-2">{description}</p>}
          <div class="mt-8 flex flex-wrap items-center gap-4">
            {!stub && <ProductCta product={product} />}
            <StatusBadge status={status} />
          </div>
          {!stub && (
            <a
              href={href}
              class="mt-8 inline-flex items-center gap-2 rounded-btn-sm font-mono text-sm text-link underline-offset-4 hover:underline"
            >
              More about {name} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
        <div class="justify-self-center" data-reveal style="--reveal-delay: 120ms">
          {heroImage ? (
            <Image
              src={heroImage}
              alt={heroImageAlt ?? ''}
              widths={[240, 480, 720]}
              sizes="240px"
              class="w-[240px] rounded-[32px] ring ring-line"
            />
          ) : (
            <div class="aspect-[4/3] w-80 max-w-full">
              <PlaceholderArt category={category} />
            </div>
          )}
        </div>
      </div>
    </article>
  ) : (
    <article
      class:list={[
        'glass-card flex flex-col overflow-hidden',
        !stub && 'group transition-[background-color] duration-200 hover:[--card-bg:var(--color-glass-2)]',
      ]}
      data-reveal
    >
      <div class="relative aspect-[16/10] overflow-hidden shadow-[inset_0_-1px_0_var(--color-line)]">
        {heroImage ? (
          <Image
            src={heroImage}
            alt={heroImageAlt ?? ''}
            widths={[240, 480]}
            sizes="(max-width: 809px) 42vw, 240px"
            class="absolute left-1/2 top-8 w-[44%] max-w-[240px] -translate-x-1/2 rounded-t-[26px] ring ring-line"
            loading="lazy"
          />
        ) : (
          <PlaceholderArt category={category} />
        )}
      </div>
      <div class="flex flex-1 flex-col gap-2 p-6">
        <p class="eyebrow">{meta}</p>
        {stub ? (
          <h3 class="text-xl font-medium tracking-tight text-ink-2">{name}</h3>
        ) : (
          <h3 class="text-xl font-medium tracking-tight">
            <a
              href={href}
              class="after:absolute after:inset-0 after:rounded-card group-hover:text-link"
            >
              {name}
            </a>
          </h3>
        )}
        <p class="text-ink-2">{tagline}</p>
        <div class="mt-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-2 pt-4">
          <StatusBadge status={status} />
          {!stub && <span class="font-mono text-xs text-ink-2">{cta.label}</span>}
        </div>
      </div>
    </article>
  )
}
