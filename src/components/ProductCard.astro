---
/**
 * Product entry. `default` is a list row with hairlines (used on the home page
 * and products index); `featured` is the large two-column block on the home page.
 * Stubs render as an unlinked "Unannounced" row.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { categoryLabel, getPrimaryCta } from '../data/product-meta';
import StatusBadge from './StatusBadge.astro';
import PlaceholderArt from './PlaceholderArt.astro';
import ProductCta from './ProductCta.astro';
import DeviceFrame from './DeviceFrame.astro';

interface Props {
  product: CollectionEntry<'products'>;
  variant?: 'default' | 'featured';
  /** Position among featured products, for the "01 / Featured" eyebrow. */
  index?: number;
}

const { product, variant = 'default', index = 0 } = Astro.props;
const { name, tagline, description, category, platforms, status, stub, heroImage, heroImageAlt } =
  product.data;
const href = `/products/${product.id}/`;
const meta = [categoryLabel[category], ...platforms].join(' · ');
const cta = getPrimaryCta(product);
const number = String(index + 1).padStart(2, '0');
---

{
  variant === 'featured' ? (
    <article class="border border-line">
      <div class="grid gap-10 p-8 md:grid-cols-2 md:items-center md:p-12 lg:p-16">
        <div data-reveal>
          <p class="eyebrow">
            {number} / Featured · {meta}
          </p>
          <h2 class="mt-5 text-4xl font-medium tracking-tighter">{name}</h2>
          <p class="mt-5 max-w-[30ch] text-xl">{tagline}</p>
          {description && <p class="mt-4 max-w-[44ch] text-muted">{description}</p>}
          <div class="mt-8 flex flex-wrap items-center gap-6">
            <ProductCta product={product} />
            <StatusBadge status={status} />
          </div>
          <a
            href={href}
            class="mt-8 inline-block font-mono text-sm underline decoration-line underline-offset-4 transition-colors hover:decoration-accent"
          >
            More about {name}
          </a>
        </div>
        <div class="flex justify-center md:justify-end" data-reveal style="--reveal-delay: 120ms">
          {category === 'ios' ? (
            <DeviceFrame src={heroImage} alt={heroImageAlt ?? ''} />
          ) : (
            <div class="aspect-[4/3] w-full max-w-md">
              <PlaceholderArt category={category} />
            </div>
          )}
        </div>
      </div>
    </article>
  ) : (
    <article
      class:list={[
        'relative grid items-center gap-5 border-t border-line py-6 md:grid-cols-[9rem_1fr_auto] md:gap-8',
        !stub && 'group',
      ]}
      data-reveal
    >
      <div class="aspect-[4/3] w-32 overflow-hidden bg-chip md:w-full">
        {heroImage ? (
          <Image
            src={heroImage}
            alt={heroImageAlt ?? ''}
            widths={[288, 576]}
            sizes="9rem"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        ) : (
          <PlaceholderArt category={category} />
        )}
      </div>
      <div>
        <p class="eyebrow">{meta}</p>
        {stub ? (
          <h3 class="mt-1.5 text-xl font-medium tracking-tight text-muted">{name}</h3>
        ) : (
          <h3 class="mt-1.5 text-xl font-medium tracking-tight">
            <a
              href={href}
              class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-accent group-hover:underline-offset-4"
            >
              {name}
            </a>
          </h3>
        )}
        <p class="mt-1 max-w-[52ch] text-muted">{tagline}</p>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 md:flex-col md:items-end md:gap-2">
        <StatusBadge status={status} />
        {!stub && <span class="font-mono text-xs text-muted">{cta.label}</span>}
      </div>
    </article>
  )
}
