---
/**
 * Fixed header: black at 80 percent with a blur and a bottom hairline (upforair.app).
 * Below 810px a menu button opens a panel. Without JavaScript the links stay inline
 * and the button is hidden, so the menu never traps anyone.
 */
import { site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="nav fixed inset-x-0 top-0 z-50" data-nav>
  <div class="site-wrap-wide relative z-[2] flex h-[var(--nav-h)] items-center justify-between gap-6">
    <a href="/" class="rounded-btn-sm text-lg font-semibold tracking-tight text-ink">{site.name}</a>

    <nav aria-label="Primary" class="nav-links flex items-center gap-6">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="font-mono text-sm text-ink-2 transition-colors duration-200 hover:text-link aria-[current=page]:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      class="nav-burger"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-burger
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="nav-menu" id="mobile-menu" data-menu>
    <nav class="site-wrap flex flex-col pb-6 pt-2" aria-label="Mobile">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="block py-3 text-xl font-medium tracking-tight shadow-[inset_0_-1px_0_var(--color-line)] transition-colors duration-200 hover:text-link"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .nav {
    background-color: color-mix(in srgb, var(--color-canvas) 80%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 -1px 0 var(--color-glass-2);
  }

  .nav-burger {
    display: none;
    width: 32px;
    height: 32px;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    border-radius: var(--radius-btn-sm);
  }

  .nav-burger span {
    display: block;
    width: 24px;
    height: 2px;
    margin-inline: auto;
    border-radius: 7px;
    background-color: var(--color-ink);
    transition:
      transform 0.3s var(--ease-out),
      opacity 0.2s ease;
  }

  .is-open .nav-burger span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .is-open .nav-burger span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.2);
  }

  .is-open .nav-burger span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .nav-menu {
    position: absolute;
    inset: var(--nav-h) 0 auto 0;
    z-index: 1;
    display: none;
    max-height: calc(100vh - var(--nav-h));
    overflow-y: auto;
    /* Opaque: a nested backdrop blur cannot see past the header, so a see-through panel shows the page. */
    background-color: var(--color-canvas);
    box-shadow: inset 0 -1px 0 var(--color-line);
    transform: translateY(-12px);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 0.3s var(--ease-out),
      opacity 0.25s ease,
      visibility 0s linear 0.3s;
  }

  .is-open .nav-menu {
    transform: none;
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  /* The menu exists only when JavaScript can open it. */
  @media (max-width: 809.98px) {
    :global(.js) .nav-links {
      display: none;
    }

    :global(.js) .nav-burger {
      display: flex;
    }

    :global(.js) .nav-menu {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const burger = header?.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = header?.querySelector<HTMLElement>('[data-menu]');

  if (header && burger && menu) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.documentElement.classList.toggle('menu-open', open);
    };

    burger.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        burger.focus();
      }
    });
    window.matchMedia('(min-width: 810px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
