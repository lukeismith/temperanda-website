---
import { site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-surface">
  <div class="mx-auto flex h-14 max-w-site items-center justify-between px-6">
    <a href="/" class="text-base font-semibold tracking-tight text-ink">{site.name}</a>
    <nav aria-label="Primary" class="flex items-center gap-6">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="font-mono text-sm text-muted transition-colors hover:text-ink aria-[current=page]:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
