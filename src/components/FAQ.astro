---
/**
 * Glass accordion on native details/summary. The same `name` makes items exclusive
 * where supported; the first item starts open, as on upforair.app.
 */
interface Props {
  items: { q: string; a: string }[];
  name?: string;
}

const { items, name = 'faq' } = Astro.props;
---

<div class="mx-auto flex w-full max-w-[800px] flex-col gap-2" data-reveal>
  {
    items.map((item, i) => (
      <details
        name={name}
        open={i === 0}
        class="group rounded-panel bg-glass px-5 py-1 inset-ring inset-ring-line backdrop-blur-[20px] transition-colors duration-200 hover:bg-white/6"
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-btn-sm py-4 text-lg font-medium tracking-tight transition-colors duration-200 hover:text-link [&::-webkit-details-marker]:hidden">
          <span>{item.q}</span>
          <span aria-hidden="true" class="relative size-3.5 flex-none">
            <i class="absolute left-0 top-1/2 -mt-px h-0.5 w-3.5 rounded-full bg-current" />
            <i class="absolute left-0 top-1/2 -mt-px h-0.5 w-3.5 rotate-90 rounded-full bg-current transition-transform duration-300 ease-out group-open:rotate-0" />
          </span>
        </summary>
        <p class="max-w-[640px] pb-[18px] text-ink-2">{item.a}</p>
      </details>
    ))
  }
</div>
