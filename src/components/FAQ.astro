---
/** Native details/summary accordion. Same `name` makes items exclusive where supported. */
interface Props {
  items: { q: string; a: string }[];
  name?: string;
}

const { items, name = 'faq' } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {
    items.map((item) => (
      <details name={name} class="group py-5">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-medium [&::-webkit-details-marker]:hidden">
          <span>{item.q}</span>
          <span aria-hidden="true" class="mt-0.5 font-mono text-muted transition-transform group-open:rotate-45">
            +
          </span>
        </summary>
        <p class="mt-3 max-w-[65ch] text-muted">{item.a}</p>
      </details>
    ))
  }
</div>
