---
/**
 * Page section with the upforair.app header: a pill label, the heading, then a lead,
 * centred by default, with 56px before the content. No hairlines between sections:
 * the section padding (96/80/64) carries the rhythm.
 */
import Tag from './Tag.astro';

export interface Props {
  eyebrow?: string;
  /** Turns the pill into a button-sized link. */
  eyebrowHref?: string;
  heading?: string;
  intro?: string;
  id?: string;
  as?: 'h1' | 'h2';
  align?: 'center' | 'left';
  /** 1200px instead of 1072px, for three-column grids. */
  wide?: boolean;
  class?: string;
}

const {
  eyebrow,
  eyebrowHref,
  heading,
  intro,
  id,
  as: Heading = 'h2',
  align = 'center',
  wide = false,
  class: className,
} = Astro.props;

const hasHeader = Boolean(eyebrow || heading || intro);
---

<section id={id} class:list={['section-pad relative', className]}>
  <div class={wide ? 'site-wrap-wide' : 'site-wrap'}>
    {
      hasHeader && (
        <div
          class:list={[
            'flex max-w-[760px] flex-col gap-[18px]',
            align === 'center' ? 'mx-auto items-center text-center' : 'items-start',
          ]}
          data-reveal
        >
          {eyebrow && (
            <Tag href={eyebrowHref} size={eyebrowHref ? 'lg' : 'md'}>
              {eyebrow}
            </Tag>
          )}
          {heading && (
            <Heading
              class:list={[
                'text-balance font-medium tracking-tighter',
                Heading === 'h1' ? 'text-4xl' : 'text-3xl',
              ]}
            >
              {heading}
            </Heading>
          )}
          {intro && <p class="max-w-[600px] text-lg text-ink-2">{intro}</p>}
        </div>
      )
    }
    <div class:list={[hasHeader && 'mt-10 md:mt-14']}>
      <slot />
    </div>
  </div>
</section>
