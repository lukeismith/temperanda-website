---
/**
 * The titanium iPhone frame from upforair.app, with a pointer-driven tilt.
 * Used only on the iPhone app pages. Pass `src` for one screenshot, or put
 * several stacked images in the slot (the feature tabs crossfade them).
 * The tilt is skipped for coarse pointers and under reduced motion.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** The hero phone loads first; every other phone loads lazily. */
  eager?: boolean;
  class?: string;
}

const { src, alt = '', eager = false, class: className } = Astro.props;
---

<div class:list={['phone', className]} data-phone>
  <div class="phone-body" data-phone-body>
    <div class="phone-frame" aria-hidden="true"></div>
    <div class="phone-btn phone-btn-left" aria-hidden="true"></div>
    <div class="phone-btn phone-btn-right-1" aria-hidden="true"></div>
    <div class="phone-btn phone-btn-right-2" aria-hidden="true"></div>

    <div class="phone-screen">
      {
        src ? (
          <Image
            src={src}
            alt={alt}
            widths={[300, 340, 600, 680, 1020]}
            sizes="(max-width: 809px) 300px, 340px"
            loading={eager ? 'eager' : 'lazy'}
            fetchpriority={eager ? 'high' : 'auto'}
            class="absolute inset-0 size-full object-cover object-top"
          />
        ) : (
          <slot />
        )
      }
      <div class="phone-island" aria-hidden="true"></div>
    </div>

    <div class="phone-highlight" aria-hidden="true"></div>
  </div>
</div>

<style>
  .phone {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    width: 100%;
    perspective: 1400px;
  }

  .phone-body {
    position: relative;
    width: min(60%, 340px);
    /* The screen inside matches a 1320 × 2868 capture. */
    aspect-ratio: 1 / 2.11;
    transform-style: preserve-3d;
    filter: drop-shadow(0 60px 80px color-mix(in srgb, var(--color-canvas) 50%, transparent))
      drop-shadow(0 25px 35px color-mix(in srgb, var(--color-canvas) 35%, transparent));
    will-change: transform;
  }

  .phone-frame {
    position: absolute;
    inset: 0;
    border-radius: 52px;
    background: linear-gradient(
      145deg,
      var(--color-titanium-1) 0%,
      var(--color-titanium-2) 28%,
      var(--color-titanium-3) 64%,
      var(--color-titanium-4) 100%
    );
    border: 1px solid color-mix(in srgb, var(--color-white) 18%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-white) 28%, transparent),
      inset 0 -1px 0 color-mix(in srgb, var(--color-canvas) 55%, transparent),
      inset 2px 0 8px color-mix(in srgb, var(--color-white) 15%, transparent),
      inset -4px 0 10px color-mix(in srgb, var(--color-canvas) 35%, transparent);
  }

  .phone-btn {
    position: absolute;
    width: 4px;
    border-radius: 4px;
    opacity: 0.75;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-white) 35%, transparent),
      color-mix(in srgb, var(--color-titanium-4) 35%, transparent)
    );
  }

  .phone-btn-left {
    left: -3px;
    top: 30%;
    height: 70px;
  }

  .phone-btn-right-1,
  .phone-btn-right-2 {
    right: -3px;
    height: 92px;
  }

  .phone-btn-right-1 {
    top: 27%;
  }

  .phone-btn-right-2 {
    top: 43%;
  }

  .phone-screen {
    position: absolute;
    inset: 9px;
    overflow: hidden;
    border-radius: 44px;
    background-color: var(--color-canvas);
    border: 1px solid color-mix(in srgb, var(--color-canvas) 35%, transparent);
  }

  .phone-island {
    position: absolute;
    top: 8px;
    left: 50%;
    z-index: 6;
    width: 37%;
    height: 30px;
    transform: translateX(-50%);
    border-radius: 18px;
    background-color: var(--color-island);
  }

  .phone-highlight {
    position: absolute;
    inset: 2px;
    border-radius: 50px;
    border-left: 1px solid color-mix(in srgb, var(--color-white) 20%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--color-white) 20%, transparent);
    opacity: 0.5;
    pointer-events: none;
  }

  @media (max-width: 809.98px) {
    .phone-body {
      width: min(76%, 300px);
    }

    .phone-frame {
      border-radius: 46px;
    }

    .phone-screen {
      border-radius: 38px;
    }

    .phone-island {
      height: 26px;
    }
  }
</style>

<script>
  const TILT = 10;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const coarse = window.matchMedia('(pointer: coarse)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-phone]')) {
    const body = root.querySelector<HTMLElement>('[data-phone-body]');
    if (!body || reduceMotion.matches || coarse.matches) continue;

    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let idle = true;
    let inView = false;
    let idleTimer: number | undefined;
    let frame: number | undefined;

    const rest = () => {
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => {
        idle = true;
        targetX = 0;
        targetY = 0;
        wake();
      }, 2000);
    };

    // Runs only while the phone is moving, so an idle page does no work.
    const tick = () => {
      const k = idle ? 0.045 : 0.12;
      currentX += (targetX - currentX) * k;
      currentY += (targetY - currentY) * k;
      body.style.transform = `rotateX(${-currentY}deg) rotateY(${currentX}deg)`;
      const settled = Math.abs(targetX - currentX) < 0.01 && Math.abs(targetY - currentY) < 0.01;
      frame = settled ? undefined : window.requestAnimationFrame(tick);
    };
    const wake = () => {
      if (frame === undefined) frame = window.requestAnimationFrame(tick);
    };

    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (!inView) {
          idle = true;
          targetX = 0;
          targetY = 0;
          wake();
        }
      },
      { threshold: 0.1 },
    ).observe(root);

    window.addEventListener(
      'pointermove',
      (e) => {
        if (!inView || e.pointerType !== 'mouse') return;
        const nx = Math.max(-1, Math.min(1, (e.clientX - innerWidth / 2) / (innerWidth / 2)));
        const ny = Math.max(-1, Math.min(1, (e.clientY - innerHeight / 2) / (innerHeight / 2)));
        targetX = nx * TILT;
        targetY = ny * TILT;
        idle = false;
        rest();
        wake();
      },
      { passive: true },
    );
    window.addEventListener('blur', rest);
    document.addEventListener('mouseleave', rest);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') rest();
    });
  }
</script>
