---
/**
 * Numbered glass card (an <li>; wrap a set in <ol>): the step number sits in a pill
 * on the card's top edge, then the heading and one sentence.
 */
interface Props {
  index: number;
  title: string;
  body: string;
}

const { index, title, body } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<li
  class="glass-card z-[1] flex flex-col gap-2.5 px-6 pb-7 pt-9"
  data-reveal
  style={`--reveal-delay: ${Math.min(index, 4) * 100}ms`}
>
  <span
    aria-hidden="true"
    class="absolute left-6 top-0 inline-flex h-[26px] min-w-[34px] -translate-y-1/2 items-center justify-center rounded-pill bg-well px-2.5 font-mono text-xs text-ink ring ring-line"
  >
    {number}
  </span>
  <h3 class="text-xl font-medium tracking-tight">{title}</h3>
  <p class="text-ink-2">{body}</p>
</li>
