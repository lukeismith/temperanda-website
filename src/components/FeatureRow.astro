---
/** Numbered feature or principle row: mono index on the left, heading and one sentence on the right. */
interface Props {
  index: number;
  title: string;
  body: string;
}

const { index, title, body } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const delay = `${Math.min(index, 4) * 60}ms`;
---

<div
  class="grid gap-3 border-t border-line py-8 md:grid-cols-[5rem_1fr] md:gap-10 md:py-10"
  data-reveal
  style={`--reveal-delay: ${delay}`}
>
  <p class="eyebrow md:pt-2">{number}</p>
  <div>
    <h3 class="text-2xl font-medium tracking-tight">{title}</h3>
    <p class="mt-2 max-w-[56ch] text-muted">{body}</p>
  </div>
</div>
