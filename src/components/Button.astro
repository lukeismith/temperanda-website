---
/**
 * The upforair.app button: radius 14, accent fill, a 0.985 press. Renders <a> when `href` is given.
 * primary: accent fill. outlined: a hairline ring. text: link colour only.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'outlined' | 'text';
  size?: 'sm' | 'md' | 'lg';
  /** Adds rel="noopener" and an outward arrow for links that leave the site. */
  external?: boolean;
  type?: 'button' | 'submit';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  type = 'button',
  class: className,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 whitespace-nowrap font-semibold transition-[background-color,color,box-shadow,scale] duration-200 ease-out active:scale-[0.985]';
const sizes = {
  sm: 'rounded-btn-sm px-3.5 py-2 text-sm',
  md: 'rounded-btn px-5 py-3 text-base',
  lg: 'min-h-[52px] rounded-btn px-6 py-3.5 text-base',
};
const variants = {
  primary: 'bg-accent text-on-accent hover:bg-accent-hover',
  outlined: 'bg-transparent text-ink inset-ring inset-ring-line-2 hover:bg-accent hover:text-on-accent hover:inset-ring-accent',
  text: 'text-link underline-offset-[3px] hover:underline',
};
const classes = [base, variant === 'text' ? 'rounded-btn-sm px-1 py-3 text-base' : sizes[size], variants[variant], className];
---

{
  href ? (
    <a href={href} class:list={classes} rel={external ? 'noopener' : undefined}>
      <slot />
      {external && <span aria-hidden="true">↗</span>}
    </a>
  ) : (
    <button type={type} class:list={classes}>
      <slot />
    </button>
  )
}
