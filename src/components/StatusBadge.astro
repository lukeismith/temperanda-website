---
import { statusLabel, type Status } from '../data/product-meta';

interface Props {
  status: Status;
  class?: string;
}

const { status, class: className } = Astro.props;
const dot: Record<Status, string> = {
  'in-development': 'bg-muted',
  beta: 'bg-accent',
  available: 'bg-accent',
};
---

<span class:list={['eyebrow inline-flex items-center gap-2', className]}>
  <span aria-hidden="true" class:list={['size-1.5 rounded-full', dot[status]]}></span>
  <span class="whitespace-nowrap text-ink">{statusLabel[status]}</span>
</span>
