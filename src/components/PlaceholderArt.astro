---
/** Decorative stand-in artwork per product category, until real images exist. Pure markup. */
import type { Category } from '../data/product-meta';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const bars = [40, 65, 30, 80, 55, 90, 45, 70, 35, 60, 85, 50];
const knobs = [0, 1, 2, 3];
---

<div aria-hidden="true" class="@container flex h-full w-full items-end justify-center overflow-hidden">
  {
    category === 'ios' && (
      <div class="relative aspect-[1/2.11] w-[34%] translate-y-[38%] rounded-[28px] bg-glass ring ring-line-2">
        <span class="absolute left-1/2 top-2.5 h-3 w-1/3 -translate-x-1/2 rounded-full bg-glass-2" />
        <div class="space-y-2 px-[14%] pt-[30%]">
          <div class="h-1.5 w-3/5 rounded-full bg-glass-2" />
          <div class="h-1.5 w-2/5 rounded-full bg-glass-2" />
        </div>
      </div>
    )
  }
  {
    category === 'max-for-live' && (
      <div class="mb-[12%] w-[72%] overflow-hidden rounded-xl bg-glass ring ring-line">
        <div class="flex items-center justify-between px-2.5 py-1.5 shadow-[inset_0_-1px_0_var(--color-line)] @md:px-3.5 @md:py-2">
          <span class="font-mono text-[8px] uppercase tracking-eyebrow text-ink-2 @md:text-[10px]">Device</span>
          <span class="size-1 rounded-full bg-link @md:size-1.5" />
        </div>
        <div class="flex items-center justify-around px-2 py-3 @md:px-3 @md:py-6">
          {knobs.map(() => (
            <span class="size-4 rounded-full ring-2 ring-line-2 @md:size-8" />
          ))}
        </div>
      </div>
    )
  }
  {
    category === 'plugin' && (
      <div class="mb-[12%] flex h-[46%] w-[72%] items-end gap-0.5 rounded-xl bg-glass px-2 pb-2 pt-4 ring ring-line @md:gap-1 @md:px-3 @md:pb-3 @md:pt-6">
        {bars.map((height) => (
          <span class="flex-1 rounded-t-sm bg-link/35" style={`height: ${height}%`} />
        ))}
      </div>
    )
  }
</div>
