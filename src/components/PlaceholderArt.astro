---
/** Decorative stand-in artwork per product category, until real images exist. Pure markup. */
import DeviceFrame from './DeviceFrame.astro';
import type { Category } from '../data/product-meta';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const bars = [40, 65, 30, 80, 55, 90, 45, 70, 35, 60, 85, 50];
const knobs = [0, 1, 2, 3];
---

<div aria-hidden="true" class="@container flex h-full w-full items-end justify-center overflow-hidden bg-chip">
  {
    category === 'ios' && (
      <div class="w-[52%] translate-y-[18%]">
        <DeviceFrame />
      </div>
    )
  }
  {
    category === 'max-for-live' && (
      <div class="mb-[10%] w-[72%] border border-line bg-panel">
        <div class="flex items-center justify-between border-b border-line px-2 py-1 @md:px-3 @md:py-1.5">
          <span class="font-mono text-[8px] uppercase tracking-eyebrow text-muted @md:text-[10px]">Device</span>
          <span class="size-1 rounded-full bg-accent @md:size-1.5" />
        </div>
        <div class="flex items-center justify-around px-2 py-2.5 @md:px-3 @md:py-5">
          {knobs.map(() => (
            <span class="size-4 rounded-full border-2 border-line @md:size-8" />
          ))}
        </div>
      </div>
    )
  }
  {
    category === 'plugin' && (
      <div class="mb-[10%] flex h-[46%] w-[72%] items-end gap-0.5 border border-line bg-panel px-2 pb-2 pt-4 @md:gap-1 @md:px-3 @md:pb-3 @md:pt-6">
        {bars.map((height) => (
          <span class="flex-1 bg-line" style={`height: ${height}%`} />
        ))}
      </div>
    )
  }
</div>
