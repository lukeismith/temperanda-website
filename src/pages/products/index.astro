---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Glow from '../../components/Glow.astro';
import ProductCard from '../../components/ProductCard.astro';
import { sortProducts } from '../../data/product-meta';

const products = sortProducts(await getCollection('products'));
---

<Base title="Products" description="iPhone apps, Max for Live devices, and audio plugins from Temperanda.">
  <div class="relative overflow-hidden">
    <Glow x="50%" y="0%" width="70%" height="40%" opacity={0.24} />
    <Section
      as="h1"
      eyebrow="Products"
      heading="Everything we're working on"
      intro="Apps for the phone, devices for Ableton Live, and plugins for everywhere else. Each entry shows where it stands."
    >
      <div class="grid gap-5 md:grid-cols-2">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </Section>
  </div>
</Base>
