---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Tag from '../components/Tag.astro';
import Glow from '../components/Glow.astro';
---

<Base title="Not found" noindex>
  <section class="section-pad relative flex min-h-[70svh] items-center overflow-hidden">
    <Glow x="50%" y="45%" width="60%" height="60%" opacity={0.24} />
    <div class="site-wrap relative z-[1] flex flex-col items-center gap-[22px] text-center">
      <Tag>404</Tag>
      <h1 class="text-balance text-display font-medium tracking-tighter">Nothing here.</h1>
      <p class="max-w-[40ch] text-lg text-ink-2">The page you were looking for doesn't exist or has moved.</p>
      <Button href="/" class="mt-2">Back to the home page</Button>
    </div>
  </section>
</Base>
