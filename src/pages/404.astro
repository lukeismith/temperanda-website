---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Not found" noindex>
  <section class="pb-24 pt-20 md:pt-32">
    <div class="mx-auto max-w-site px-6">
      <p class="eyebrow">404</p>
      <h1 class="mt-6 text-display font-medium tracking-tighter">Nothing here.</h1>
      <p class="mt-8 max-w-[40ch] text-lg text-muted">
        The page you were looking for doesn't exist or has moved.
      </p>
      <div class="mt-10">
        <Button href="/">Back to the home page</Button>
      </div>
    </div>
  </section>
</Base>
