---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Tag from '../components/Tag.astro';
import Glow from '../components/Glow.astro';
import ProductCard from '../components/ProductCard.astro';
import FeatureRow from '../components/FeatureRow.astro';
import { site } from '../data/site';
import { sortProducts } from '../data/product-meta';

// The home page shows only the featured products; /products/ lists all of them.
const products = sortProducts(await getCollection('products')).filter((p) => p.data.featured);

// Draft copy: edit freely.
const approach = [
  {
    title: 'Fewer features, finished.',
    body: 'Quality over quantity is our guiding principle.',
  },
  {
    title: 'Tools that stay out of the way.',
    body: 'Good software is quiet. The apps and devices we make are meant to be user friendly and helpful.',
  },
  {
    title: 'Made by people who use them daily.',
    body: 'Everything here started as something we wanted for ourselves, in the studio or on the phone.',
  },
];
---

<Base>
  <section class="relative overflow-hidden pb-10 pt-10 md:pb-14 md:pt-[72px]">
    <Glow x="50%" y="35%" width="70%" height="70%" opacity={0.3} />
    <div class="site-wrap relative z-[1] flex flex-col items-center text-center">
      <Tag data-reveal>{site.name} · Software studio</Tag>
      <h1
        class="mt-6 max-w-[12ch] text-balance text-display font-medium tracking-tighter"
        data-reveal
        style="--reveal-delay: 60ms"
      >
        Software for focus and sound.
      </h1>
      <p class="mt-8 max-w-[40ch] text-lg text-ink-2" data-reveal style="--reveal-delay: 120ms">
        An independent software startup developing tools for focus, sound, and creativity. We make apps for Mac, iOS, and the web.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal style="--reveal-delay: 180ms">
        <Button href="/about/" variant="outlined" size="lg">About the studio</Button>
      </div>
    </div>
  </section>

  <Section
    eyebrow="Products"
    eyebrowHref="/products/"
    heading="What we're making"
    intro="Three kinds of tools from one studio. Names and dates appear here as each one gets close."
  >
    <div class="flex flex-col gap-6">
      {products.map((product) => <ProductCard product={product} variant="wide" />)}
    </div>
  </Section>

  <Section eyebrow="Approach" heading="How we work" wide>
    <div class="relative">
      <Glow tone="link" x="50%" y="40%" width="80%" height="70%" opacity={0.12} />
      <ol class="relative grid gap-7 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
        {approach.map((item, i) => <FeatureRow index={i} title={item.title} body={item.body} />)}
      </ol>
    </div>
  </Section>
</Base>
